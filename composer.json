{
  "name": "devfaysal/laravel-icombd-message",
  "description": "Simple Laravel wrapper for ICombd Message Gateway API",
  "keywords": [
    "Icombd",
    "php",
    "api",
    "laravel"
  ],
  "homepage": "https://github.com/devfaysal/laravel-icombd-message",
  "license": "MIT",
  "type": "library",
  "authors": [
    {
      "name": "Faysal Ahamed",
      "email": "devfaysal@gmail.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.3",
    "guzzlehttp/guzzle": "^7.8.2",
    "illuminate/http": "^13.0",
    "illuminate/support": "^13.0"
  },
  "require-dev": {
    "laravel/pint": "^1.32",
    "orchestra/testbench": "^11.0",
    "phpstan/phpstan": "^2.3",
    "phpunit/phpunit": "^12.5.8"
  },
  "autoload": {
    "psr-4": {
      "Devfaysal\\Icombd\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Devfaysal\\Icombd\\Tests\\": "tests"
    }
  },
  "scripts": {
    "analyse": "@php vendor/bin/phpstan analyse --memory-limit=512M",
    "format": "@php vendor/bin/pint",
    "format:check": "@php vendor/bin/pint --test",
    "test": "@php vendor/bin/phpunit",
    "test-coverage": "@php vendor/bin/phpunit --coverage-html coverage"
  },
  "config": {
    "sort-packages": true
  },
  "extra": {
    "laravel": {
      "providers": [
        "Devfaysal\\Icombd\\IcombdServiceProvider"
      ],
      "aliases": {
        "Icombd": "Devfaysal\\Icombd\\Facades\\Icombd"
      }
    }
  }
}
